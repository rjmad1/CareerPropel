# Database
DATABASE_URL="postgresql://career_user:career_pass@localhost:5432/career_propel_dev"

# Redis
REDIS_URL="redis://localhost:6379"

# Authentication
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-run-openssl-rand-base64-32"

# OAuth Providers (GitHub example)
GITHUB_ID="your-github-oauth-id"
GITHUB_SECRET="your-github-oauth-secret"

# API Configuration
NODE_ENV="development"
LOG_LEVEL="debug"
API_RATE_LIMIT="100"

# Feature Flags
FEATURE_INTERVIEW_PREP="true"
FEATURE_AGENT_VISIBILITY="true"
FEATURE_RESUME_APPROVAL="true"

# Optional: AI/ML (Phase 2)
OPENAI_API_KEY="sk-..."
