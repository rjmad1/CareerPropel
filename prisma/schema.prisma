// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── RBAC Governance Enums ────────────────────────────────────────────────────

/// Canonical role classification for the governance layer.
enum RoleType {
  SUPER_ADMIN
  PLATFORM_ADMIN
  SECURITY_ADMIN
  SUPPORT_ADMIN
  JOB_SEEKER
  CUSTOM
}

/// Effect of a capability override: explicit allow or deny.
enum CapabilityEffect {
  allow
  deny
}

/// Rollout strategy for feature flags.
enum RolloutStrategy {
  all
  percentage
  allowlist
  role_scoped
  disabled
}

// ─── Enums (RASUI-012: state-machine integrity) ───────────────────────────────

/// 14-stage job pipeline. DB-enforced — invalid stages cannot be persisted.
enum JobStage {
  sourced
  interested
  resume_tailoring
  applied
  recruiter_screen
  hiring_manager
  technical_interview
  system_design
  behavioral
  final_round
  offer
  negotiation
  rejected
  archived
}

/// Agent execution lifecycle states.
enum AgentExecutionStatus {
  queued
  running
  paused
  completed
  failed
  interrupted
}

/// Source that triggered an agent execution.
enum ExecutionSource {
  cron
  queue
  retry
  fallback
  manual
}

/// Reason an in-flight execution was interrupted.
enum InterruptionReason {
  deploy_shutdown
  stall_detected
  heartbeat_timeout
}

/// Classification of execution failure type.
enum FailureClassification {
  provider_error
  timeout
  cost_ceiling
  validation_error
}

/// Deployment environment.
enum DeploymentEnvironment {
  staging
  production
}

/// Interview lifecycle states.
enum InterviewStatus {
  scheduled
  completed
  cancelled
  rescheduled
  no_show
}

/// Job offer lifecycle states.
enum OfferStatus {
  pending
  received
  accepted
  rejected
  negotiating
}

/// Skill proficiency levels.
enum SkillProficiency {
  beginner
  intermediate
  advanced
  expert
}

// ─── Identity & Candidate Profile ───────────────────────────────────────────

model Candidate {
  id                        String    @id @default(cuid())
  email                     String    @unique
  name                      String
  phone                     String?
  location                  String?
  summary                   String?
  avatarUrl                 String?
  // Credential auth
  passwordHash              String?
  emailVerified             Boolean   @default(false)
  emailVerificationToken    String?
  emailVerificationTokenExp DateTime?
  passwordResetToken        String?
  passwordResetTokenExp     DateTime?
  // User preferences: { emailNotifications: bool, theme: 'light'|'dark'|'system' }
  preferences               Json?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  jobs                    Job[]
  profileData             ProfileData[]
  skills                  Skill[]
  achievements            Achievement[]
  documents               Document[]
  interviewFeedback       InterviewFeedback[]
  offers                  Offer[]
  interviews              Interview[]
  profileEntities         ProfileEntity[]
  profileScore            ProfileScore?
  interviewPreps          InterviewPrep[]
  starStories             StarStory[]
  calendarTokens          CalendarToken[]
  calendarEvents          CalendarEvent[]
  jobImports              JobImport[]
  accomplishments         Accomplishment[]
  appraisalSessions       AppraisalSession[]
  contacts                Contact[]
  mockInterviewSessions   MockInterviewSession[]
  workflowExecutions      WorkflowExecution[]
  approvalRequests        ApprovalRequest[]
  opportunityPlans        OpportunityPlan[]
  workflowSchedules       WorkflowSchedule[]
  // Document orchestration
  accomplishmentBankItems AccomplishmentBankItem[]
  resumeVariants          ResumeVariant[]
  keywordAlignmentAudits  KeywordAlignmentAudit[]
  parserValidationReports ParserValidationReport[]
  applicationPackages     ApplicationPackage[]

  // Role Intelligence & Fit Evaluation
  jobIntelligence       JobIntelligence[]
  strengthEvidences     StrengthEvidence[]
  fitGaps               FitGap[]
  fitScoringSnapshots   FitScoringSnapshot[]
  roleFitAnalyses       RoleFitAnalysis[]
  patternLibraryEntries PatternLibraryEntry[]
}

// ─── Job Pipeline ────────────────────────────────────────────────────────────

model Job {
  id             String    @id @default(cuid())
  candidateId    String
  title          String
  company        String
  description    String?
  url            String?
  location       String?
  salary         Int?
  matchScore     Float?    @default(0)
  priority       String    @default("medium") // low, medium, high
  recruiterName  String?
  recruiterEmail String?
  recruiterPhone String?
  notes          String?
  tags           String[]
  stage          JobStage  @default(sourced)
  appliedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  candidate             Candidate              @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobIntelligence       JobIntelligence?
  strengthEvidences     StrengthEvidence[]
  fitGaps               FitGap[]
  fitScoringSnapshots   FitScoringSnapshot[]
  roleFitAnalyses       RoleFitAnalysis[]
  activities            JobActivity[]
  interviewFeedback     InterviewFeedback[]
  offers                Offer[]
  interviews            Interview[]
  documents             Document[]
  interviewPrep         InterviewPrep?
  mockInterviewSessions MockInterviewSession[]
  opportunityPlan       OpportunityPlan?
  resumeVariants        ResumeVariant[]
  jobIntelligence       JobIntelligence?
  outreachCampaigns     OutreachCampaign[]

  @@index([candidateId])
  @@index([stage])
}

model JobActivity {
  id        String   @id @default(cuid())
  jobId     String
  action    String // applied, progressed, rejected, etc.
  metadata  Json?
  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model Interview {
  id              String          @id @default(cuid())
  candidateId     String
  jobId           String
  type            String // phone, video, onsite, panel, technical, behavioral
  scheduledAt     DateTime
  duration        Int? // minutes
  location        String?
  meetingLink     String?
  calendarEventId String? // linked CalendarEvent.id after auto-sync
  notes           String?
  status          InterviewStatus @default(scheduled)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([jobId])
}

model InterviewFeedback {
  id          String   @id @default(cuid())
  candidateId String
  jobId       String
  type        String // behavioral, technical, system_design, other
  selfRating  Int? // 1-5 scale
  notes       String?
  createdAt   DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([jobId])
}

model Offer {
  id          String      @id @default(cuid())
  candidateId String
  jobId       String
  salary      Int?
  equity      String?
  bonus       Int?
  benefits    String?
  startDate   DateTime?
  status      OfferStatus @default(pending)
  negotiated  Boolean     @default(false)
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([jobId])
}

// ─── Profile Intelligence ────────────────────────────────────────────────────

model ProfileData {
  id          String   @id @default(cuid())
  candidateId String
  type        String // resume, cover_letter, linkedin_export, notes, etc.
  content     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, type])
  @@index([candidateId])
}

model Skill {
  id          String           @id @default(cuid())
  candidateId String
  name        String
  proficiency SkillProficiency @default(beginner)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, name])
  @@index([candidateId])
}

model Achievement {
  id          String   @id @default(cuid())
  candidateId String
  title       String
  description String
  metrics     Json? // quantifiable results
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

model Document {
  id          String   @id @default(cuid())
  candidateId String
  jobId       String?
  name        String
  type        String // resume, cover_letter, pdf, docx, txt, etc.
  url         String?
  content     String?
  version     String?
  tags        String[]
  uploadedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([candidateId])
  @@index([jobId])
}

model ProfileEntity {
  id          String   @id @default(cuid())
  candidateId String
  type        String // skill, experience, education, certification, project, etc.
  data        Json
  source      String? // which document or profile data it was extracted from
  confidence  Float? // AI extraction confidence score (0-1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([type])
}

model ProfileScore {
  id              String   @id @default(cuid())
  candidateId     String   @unique
  overall         Int      @default(0) // 0-100
  sections        Json? // per-section breakdown
  recommendations Json? // improvement suggestions
  calculatedAt    DateTime @default(now())
  updatedAt       DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

// ─── Interview Intelligence ──────────────────────────────────────────────────

model InterviewPrep {
  id                String    @id @default(cuid())
  candidateId       String
  jobId             String    @unique // one prep package per job
  role              String
  company           String
  prepStatus        String    @default("not_started") // not_started, generating, ready, stale
  confidenceScore   Float     @default(0) // 0–1
  contentVersion    Int       @default(1)
  companyResearch   Json? // serialised CompanyResearch
  roleBreakdown     Json? // serialised RoleBreakdown
  technicalPrep     Json? // serialised TechnicalPrep
  systemDesignPrep  Json? // serialised SystemDesignPrep
  resumeAlignment   Json? // serialised ResumeAlignment
  compensationGuide Json? // serialised CompensationGuide
  generatedAt       DateTime?
  expiresAt         DateTime?
  userModifications Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  candidate   Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job         Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  starStories StarStory[]

  @@index([candidateId])
}

model StarStory {
  id                 String   @id @default(cuid())
  candidateId        String
  interviewPrepId    String? // optional: linked to a specific prep package
  competency         String // primary competency (e.g. "leadership")
  competencies       String[] // additional competencies this story covers
  title              String
  summary            String?
  situation          String
  task               String
  action             String
  result             String
  metrics            String[] // quantifiable outcomes
  sourceProject      String? // project from resume this story draws from
  relevanceScore     Float    @default(0) // 0–1
  timeToTell         Int? // estimated seconds to deliver
  confidence         Int? // 0–100 user confidence rating
  interviewQuestions String[] // interview questions this story can answer
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  candidate     Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  interviewPrep InterviewPrep? @relation(fields: [interviewPrepId], references: [id], onDelete: SetNull)

  @@index([candidateId])
  @@index([interviewPrepId])
}

// ─── Agent Operations ────────────────────────────────────────────────────────

model AgentExecution {
  id           String               @id @default(cuid())
  userId       String // NextAuth user ID or email — not a FK
  agentType    String // resume-tailor, job-match, interview-prep, research, follow-up, networking
  jobId        String? // denormalized from input.jobId for precise indexed queries
  status       AgentExecutionStatus @default(queued)
  input        String? // JSON-serialised AgentPromptContext
  output       String? // JSON-serialised result
  tokenCount   Int?
  durationMs   Int?
  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  // Execution source & worker identity
  executionSource    ExecutionSource?
  workerId           String?
  queuedAt           DateTime?
  interruptedAt      DateTime?
  interruptionReason InterruptionReason?

  // Cost governance
  estimatedCost Float?
  actualCost    Float?
  tokenUsage    Json? // { inputTokens: number, outputTokens: number }
  provider      String?
  model         String?
  latencyMs     Int?

  // Retry lineage
  retryCount            Int                    @default(0)
  retryLineage          Json? // array of retry attempt objects
  failureClassification FailureClassification?

  // Deployment provenance
  deploymentVersion         String?
  deploymentSha             String?
  deploymentTimestamp       DateTime?
  deploymentEnvironment     DeploymentEnvironment?
  railwayServiceId          String?
  previousDeploymentVersion String?

  // Governance fields (WI3/WI4)
  queueJobId        String?
  requestId         String?
  correlationId     String?
  progress          Int      @default(0)
  attempts          Int      @default(0)
  providerId        String?
  currentTask       String?
  promptVersionId   String?
  promptHash        String?
  modelId           String?
  fallbackUsed      Boolean  @default(false)
  fallbackReason    String?
  sanitizerVersion  String?
  inputTokens       Int?
  outputTokens      Int?
  costUsd           Float?
  validationPassed  Boolean?
  validationErrors  Json?
  validationVersion String?
  schemaValidated   Boolean?
  semanticValidated Boolean?
  policyValidated   Boolean?
  metadata          Json?

  toolCalls     ToolCall[]
  eventLogs     EventLog[]
  promptVersion PromptVersion? @relation(fields: [promptVersionId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([executionSource])
  @@index([queuedAt])
  @@index([jobId])
  @@index([queueJobId])
  @@index([promptVersionId])
}

model ToolCall {
  id          String    @id @default(cuid())
  executionId String
  tool        String // tool name/identifier
  toolName    String? // alias/display name
  input       Json?
  output      Json?
  error       String?
  status      String    @default("pending") // pending, running, completed, failed
  startedAt   DateTime?
  completedAt DateTime?
  durationMs  Int?
  tokens      Int?
  createdAt   DateTime  @default(now())

  execution AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
}

model EventLog {
  id          String   @id @default(cuid())
  executionId String
  level       String // INFO, WARN, ERROR
  message     String
  metadata    Json?
  timestamp   DateTime @default(now())

  execution AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@index([timestamp])
}

// ─── Security & Admin ────────────────────────────────────────────────────────

model Role {
  id                  String   @id @default(cuid())
  name                String   @unique
  description         String?
  roleType            RoleType @default(CUSTOM)
  immutableSystemRole Boolean  @default(false)
  priority            Int      @default(100) // lower = higher priority in resolution
  environmentScope    String? // null = all, "staging", "production"
  metadata            Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  permissions RolePermission[]
  userRoles   UserRole[]
}

model Permission {
  id              String   @id @default(cuid())
  name            String   @unique // canonical key e.g. "agents.execute"
  description     String?
  resource        String // e.g. "agents"
  action          String // e.g. "execute"
  systemProtected Boolean  @default(false) // immutable system permissions
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  roles     RolePermission[]
  overrides UserCapabilityOverride[]

  @@unique([resource, action])
  @@index([resource])
  @@index([systemProtected])
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRole {
  id            String    @id @default(cuid())
  email         String
  roleId        String
  grantedBy     String?
  revokedBy     String?
  justification String?
  isActive      Boolean   @default(true)
  grantedAt     DateTime  @default(now())
  revokedAt     DateTime?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([email, roleId])
  @@index([email])
  @@index([roleId])
  @@index([isActive])
  @@index([expiresAt])
}

/// Per-user permission overrides — temporary or permanent allow/deny that bypass role assignment.
model UserCapabilityOverride {
  id            String           @id @default(cuid())
  userId        String // Candidate.id
  permissionId  String
  effect        CapabilityEffect
  justification String?
  createdBy     String // admin email who created this
  expiresAt     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
  @@index([expiresAt])
}

/// Centralized feature flag store — gates platform capabilities at runtime.
model FeatureFlag {
  id              String          @id @default(cuid())
  key             String          @unique
  description     String?
  enabled         Boolean         @default(false)
  rolloutStrategy RolloutStrategy @default(disabled)
  rolloutPercent  Float? // 0–100 for percentage rollouts
  allowedUserIds  String[] // explicit user allowlist
  allowedRoles    String[] // role-scoped rollout
  environment     String? // null = all, "staging", "production"
  metadata        Json?
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([key])
  @@index([enabled])
  @@index([environment])
}

/// Structured authorization decision log — separate from generic AuditLog for queryability.
model AuthorizationAuditLog {
  id            String   @id @default(cuid())
  actorId       String? // Candidate.id of the actor
  actorEmail    String
  targetEmail   String? // user being acted upon (impersonation, role changes)
  permission    String // permission evaluated e.g. "agents.execute"
  decision      String // "allow" | "deny"
  reason        String? // human-readable reason for the decision
  resource      String? // resource being accessed
  resourceId    String?
  ipAddress     String?
  userAgent     String?
  correlationId String?
  requestId     String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([actorEmail])
  @@index([permission])
  @@index([decision])
  @@index([createdAt])
  @@index([correlationId])
}

model TwoFactorSecret {
  id          String    @id @default(cuid())
  email       String    @unique
  secret      String // Encrypted TOTP secret
  backupCodes String[] // Encrypted backup codes
  enabled     Boolean   @default(false)
  enabledAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([email])
}

model ApiKey {
  id         String    @id @default(cuid())
  email      String // Links to Candidate email
  keyHash    String // Hash of the actual key (key itself never stored)
  name       String // User-defined name
  prefix     String    @unique // "sk_" prefix for identification
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
  lastUsedAt DateTime?
  revokedAt  DateTime?
  usageCount Int       @default(0)

  @@unique([email, name])
  @@index([email])
  @@index([prefix])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  email      String
  action     String // LOGIN, JOB_CREATED, JOB_DELETED, API_KEY_CREATED, etc.
  resource   String
  resourceId String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  status     String // "success" or "failure"
  severity   String   @default("info") // "info", "warning", "error", "critical"
  createdAt  DateTime @default(now())

  @@index([email])
  @@index([action])
  @@index([createdAt])
  @@index([severity])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  ipAddress String?
  userAgent String?
  timestamp DateTime @default(now())

  @@index([email])
  @@index([timestamp])
  @@index([success])
}

model SessionActivity {
  id        String   @id @default(cuid())
  email     String
  sessionId String
  action    String // "login", "logout", "api_call", "data_access", etc.
  ipAddress String?
  userAgent String?
  riskScore Int      @default(0) // 0-100, higher = more suspicious
  timestamp DateTime @default(now())

  @@index([email])
  @@index([sessionId])
  @@index([timestamp])
  @@index([riskScore])
}

// ─── Calendar Integration ─────────────────────────────────────────────────────

model CalendarToken {
  id           String    @id @default(cuid())
  candidateId  String
  provider     String // "google" | "outlook"
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  scope        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Encryption versioning for key rotation
  encryptionVersion Int       @default(1)
  encryptionKeyId   String    @default("primary")
  migratedAt        DateTime?
  isLegacy          Boolean   @default(true)

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, provider])
  @@index([candidateId])
  @@index([isLegacy])
}

model CalendarEvent {
  id          String   @id @default(cuid())
  candidateId String
  externalId  String // Google/Outlook event ID
  provider    String // "google" | "outlook"
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime
  location    String?
  meetingUrl  String?
  jobId       String?
  interviewId String?
  syncedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, externalId, provider])
  @@index([candidateId])
  @@index([startAt])
}

// ─── Job Board Import ─────────────────────────────────────────────────────────

model JobImport {
  id          String   @id @default(cuid())
  candidateId String
  source      String // "greenhouse" | "indeed" | "linkedin" | "manual"
  externalId  String? // source job ID where available
  rawData     Json // full scraped/fetched payload
  imported    Boolean  @default(false)
  jobId       String? // set after user accepts and a Job record is created
  createdAt   DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([source])
}

// ─── AI Platform Evolution Configurations ────────────────────────────────────

model AiProviderConfig {
  id           String   @id @default(cuid())
  candidateId  String
  providerName String // "openai", "anthropic", "gemini", "ollama", "openrouter", etc.
  endpointUrl  String? // Custom endpoint (e.g. http://localhost:11434/api)
  encryptedKey String? // AES-GCM encrypted API key
  isActive     Boolean  @default(true)
  priority     Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([candidateId, providerName])
  @@index([candidateId])
}

model UserCapabilityPreset {
  id           String   @id @default(cuid())
  candidateId  String
  presetName   String // "resume_optimization", "technical_interview", etc.
  providerName String // Selected fallback provider
  modelName    String // Selected fallback model
  maxCostLimit Float    @default(0.05) // Max spend per invocation
  privacyMode  String   @default("enterprise") // "local", "zero_retention", "enterprise", "anonymous"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([candidateId, presetName])
  @@index([candidateId])
}

model TokenUsageLog {
  id           String   @id @default(cuid())
  candidateId  String
  executionId  String?
  presetName   String
  providerName String
  modelName    String
  inputTokens  Int
  outputTokens Int
  costUsd      Float
  createdAt    DateTime @default(now())

  @@index([candidateId])
  @@index([createdAt])
}

model PromptVersion {
  id                   String    @id @default(cuid())
  capability           String // E.g., "ATS_OPTIMIZATION"
  agentType            String? // agent type tag (e.g. "resume-tailor")
  version              String    @default("1.0.0") // semver string
  template             String // User prompt template text
  systemPrompt         String? // system prompt override
  systemHash           String? // SHA-256 of systemPrompt
