model Contact {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  name        String
  company     String?
  role        String?
  email       String?
  phone       String?
  linkedInUrl String?

  // "recruiter" | "hiring_manager" | "referral" | "peer" | "other"
  type   String @default("recruiter")
  // "to_contact" | "reached_out" | "responded" | "met" | "introduced" | "closed"
  status String @default("to_contact")

  jobId           String? // optional link to a pipeline job
  notes           String?
  followUpAt      DateTime?
  lastContactedAt DateTime?

  // Intelligence fields
  contactType              ContactType?
  recruiterType            RecruiterType?
  influenceScore           Float          @default(0)
  hiringAuthorityScore     Float          @default(0)
  outreachPriority         Int            @default(0)
  responseProbability      Float          @default(0)
  linkedinConnectionDegree Int?
  mutualConnections        Int            @default(0)
  discoveryMetadata        Json?
  lastInteractionAt        DateTime?
  lastReplyAt              DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outreaches          Outreach[]
  sourceRelationships RelationshipGraph[] @relation("SourceContact")
  targetRelationships RelationshipGraph[] @relation("TargetContact")

  @@index([candidateId])
  @@index([candidateId, status])
  @@index([contactType])
  @@index([influenceScore])
}

model OutreachCampaign {
  id          String                 @id @default(cuid())
  candidateId String
  jobId       String?
  company     String
  objective   String
  status      OutreachCampaignStatus @default(PLANNING)
  startedAt   DateTime?
  completedAt DateTime?
  metadata    Json?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  outreaches Outreach[]
  job        Job?       @relation(fields: [jobId], references: [id])

  @@index([candidateId])
  @@index([status])
}

model Outreach {
  id                  String          @id @default(cuid())
  campaignId          String
  contactId           String
  channel             OutreachChannel
  message             String          @db.Text
  personalizedMessage String?         @db.Text
  status              OutreachStatus  @default(DRAFT)
  sequenceStep        Int             @default(0)
  scheduledAt         DateTime?
  sentAt              DateTime?
  deliveredAt         DateTime?
  viewedAt            DateTime?
  repliedAt           DateTime?
  responseSentiment   String?
  approvedBy          String?
  approvedAt          DateTime?
  metadata            Json?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  campaign OutreachCampaign @relation(fields: [campaignId], references: [id])
  contact  Contact          @relation(fields: [contactId], references: [id])

  @@index([campaignId])
  @@index([contactId])
  @@index([status])
}

model RelationshipGraph {
  id               String               @id @default(cuid())
  candidateId      String
  sourceContactId  String
  targetContactId  String
  relationshipType String
  strength         RelationshipStrength @default(COLD)
  confidence       Float                @default(0)
  metadata         Json?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  sourceContact Contact @relation("SourceContact", fields: [sourceContactId], references: [id])
  targetContact Contact @relation("TargetContact", fields: [targetContactId], references: [id])

  @@index([candidateId])
  @@index([sourceContactId, targetContactId])
}

model EngagementMetric {
  id          String   @id @default(cuid())
  candidateId String
  campaignId  String?
  metricType  String
  value       Float
  dimension   String?
  measuredAt  DateTime @default(now())
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([candidateId, metricType])
  @@index([measuredAt])
}

// ─── Workflow Orchestration ───────────────────────────────────────────────────

enum WorkflowStatus {
  queued
  running
  waiting_for_approval
  blocked
  failed
  completed
  cancelled
}

enum StepStatus {
  pending
  running
  waiting_for_approval
  completed
  failed
  skipped
}

enum StepType {
  agent_call
  approval
  condition
  notification
  delay
}

enum ApprovalDecision {
  approved
  rejected
  modified
}

enum ApprovalActionType {
  send_outreach
  send_followup
  submit_document
  compensation_comm
  networking_comm
}

enum ScheduleTriggerType {
  recurring
  one_time
  inactivity
  stage_change
}

model WorkflowDefinition {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  description String?
  version     Int      @default(1)
  isActive    Boolean  @default(true)
  steps       Json
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  executions WorkflowExecution[]
  schedules  WorkflowSchedule[]

  @@index([name])
  @@index([isActive])
}

model WorkflowExecution {
  id               String         @id @default(cuid())
  candidateId      String
  jobId            String?
  definitionId     String
  status           WorkflowStatus @default(queued)
  currentStepIndex Int            @default(0)
  context          Json?
  metadata         Json?
  triggeredBy      String?
  startedAt        DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  failedAt         DateTime?
  errorMessage     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  candidate  Candidate               @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  definition WorkflowDefinition      @relation(fields: [definitionId], references: [id])
  steps      WorkflowStepExecution[]
  approvals  ApprovalRequest[]

  @@index([candidateId])
  @@index([jobId])
  @@index([status])
  @@index([definitionId])
}

model WorkflowStepExecution {
