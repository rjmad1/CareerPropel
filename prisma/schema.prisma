// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Candidate {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs              Job[]
  profileData       ProfileData[]
  skills            Skill[]
  achievements      Achievement[]
  documents         Document[]
  interviewFeedback InterviewFeedback[]
  offers            Offer[]
}

model Job {
  id          String   @id @default(cuid())
  candidateId String
  title       String
  company     String
  description String?
  url         String?
  stage       String   @default("sourced") // sourced, interested, resume_tailoring, applied, recruiter_screen, hiring_manager, technical_interview, system_design, behavioral, final_round, offer, negotiation, rejected, archived
  appliedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  candidate         Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  activities        JobActivity[]
  interviewFeedback InterviewFeedback[]
  offers            Offer[]

  @@index([candidateId])
  @@index([stage])
}

model JobActivity {
  id        String   @id @default(cuid())
  jobId     String
  action    String // applied, progressed, rejected, etc.
  metadata  Json?
  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model ProfileData {
  id          String   @id @default(cuid())
  candidateId String
  type        String   // resume, cover_letter, linkedin_export, notes, etc.
  content     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

model Skill {
  id          String   @id @default(cuid())
  candidateId String
  name        String
  proficiency Int      @default(1) // 1-5 scale
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, name])
  @@index([candidateId])
}

model Achievement {
  id          String   @id @default(cuid())
  candidateId String
  title       String
  description String
  metrics     Json?    // quantifiable results
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

model Document {
  id          String   @id @default(cuid())
  candidateId String
  name        String
  type        String   // pdf, docx, txt, etc.
  url         String
  uploadedAt  DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

model InterviewFeedback {
  id          String   @id @default(cuid())
  candidateId String
  jobId       String
  type        String   // behavioral, technical, system_design, other
  selfRating  Int?     // 1-5 scale
  notes       String?
  createdAt   DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([jobId])
}

model Offer {
  id          String   @id @default(cuid())
  candidateId String
  jobId       String
  salary      Int?
  equity      String?
  bonus       Int?
  startDate   DateTime?
  status      String   @default("pending") // pending, accepted, rejected, negotiating
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([jobId])
}

// Phase 3: Role-Based Access Control (RBAC)
model Role {
  id          String   @id @default(cuid())
  name        String   @unique // "admin", "recruiter", "candidate", etc.
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions    RolePermission[]
  userRoles      UserRole[]
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique // "jobs.create", "jobs.read", "jobs.update", "jobs.delete", etc.
  description String?
  resource    String   // "jobs", "users", "audit", etc.
  action      String   // "create", "read", "update", "delete", "manage"
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@unique([resource, action])
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRole {
  id        String   @id @default(cuid())
  email     String   // Links to Candidate email
  roleId    String
  grantedBy String?  // Email of admin who granted
  grantedAt DateTime @default(now())
  expiresAt DateTime? // Optional role expiration
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([email, roleId])
  @@index([email])
  @@index([roleId])
}

// Phase 3: Two-Factor Authentication
model TwoFactorSecret {
  id        String   @id @default(cuid())
  email     String   @unique
  secret    String   // Encrypted TOTP secret
  backupCodes String[] // Encrypted backup codes
  enabled   Boolean  @default(false)
  enabledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

// Phase 3: API Key Management
model ApiKey {
  id        String   @id @default(cuid())
  email     String   // Links to Candidate email
  keyHash   String   // Hash of the actual key (key itself never stored)
  name      String   // User-defined name
  prefix    String   @unique // "sk_" prefix for identification
  createdAt DateTime @default(now())
  expiresAt DateTime? // When the key expires
  lastUsedAt DateTime?
  revokedAt DateTime? // When the key was revoked
  usageCount Int      @default(0)

  @@unique([email, name])
  @@index([email])
  @@index([prefix])
  @@index([expiresAt])
}

// Phase 3: Audit Logging
model AuditLog {
  id        String   @id @default(cuid())
  email     String   // User email
  action    String   // LOGIN, JOB_CREATED, JOB_DELETED, API_KEY_CREATED, etc.
  resource  String   // What was affected (job, user, settings, etc.)
  resourceId String? // ID of the affected resource
  details   Json?    // Additional context/metadata
  ipAddress String?
  userAgent String?
  status    String   // "success" or "failure"
  severity  String   @default("info") // "info", "warning", "error", "critical"
  createdAt DateTime @default(now())

  @@index([email])
  @@index([action])
  @@index([createdAt])
  @@index([severity])
}

// Phase 3: Advanced Threat Detection
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  ipAddress String?
  userAgent String?
  timestamp DateTime @default(now())

  @@index([email])
  @@index([timestamp])
  @@index([success])
}

model SessionActivity {
  id        String   @id @default(cuid())
  email     String
  sessionId String
  action    String   // "login", "logout", "api_call", "data_access", etc.
  ipAddress String?
  userAgent String?
  riskScore Int      @default(0) // 0-100, higher = more suspicious
  timestamp DateTime @default(now())

  @@index([email])
  @@index([sessionId])
  @@index([timestamp])
  @@index([riskScore])
}

model AgentExecution {
  id            String    @id @default(cuid())
  userId        String
  jobId         String?
  agentType     String
  status        String    @default("queued")
  input         String?
  output        String?
  errorMessage  String?
  tokenCount    Int?
  durationMs    Int?
  queueJobId    String?
  currentTask   String?
  progress      Int       @default(0)
  attempts      Int       @default(0)
  providerId    String?
  requestId     String?
  correlationId String?
  metadata      Json?
  createdAt     DateTime  @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  updatedAt     DateTime  @updatedAt

  toolCalls ToolCall[]
  eventLogs EventLog[]

  @@index([userId, status])
  @@index([jobId])
  @@index([queueJobId])
  @@index([agentType, createdAt])
}

model ToolCall {
  id          String    @id @default(cuid())
  executionId String
  toolName    String
  status      String    @default("pending")
  input       Json?
  output      Json?
  error       String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  durationMs  Int?
  tokens      Int?
  metadata    Json?

  execution AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, status])
  @@index([toolName])
}

model EventLog {
  id          String   @id @default(cuid())
  executionId String
  level       String
  message     String
  metadata    Json?
  timestamp   DateTime @default(now())

  execution AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, timestamp])
  @@index([level, timestamp])
}
