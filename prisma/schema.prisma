// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Candidate {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Week 1-5: Core relations
  jobs              Job[]
  profileData       ProfileData[]
  skills            Skill[]
  achievements      Achievement[]
  documents         Document[]
  interviewFeedback InterviewFeedback[]
  offers            Offer[]

  // Week 6: Profile Intelligence System
  profileEntities   ProfileEntity[]
  extractionLogs    ExtractionLog[]
  profileScore      ProfileScore?

  // Week 6: Agent Execution Timeline
  agentExecutions   AgentExecution[]

  // Week 6: Interview Preparation
  interviewPreps    InterviewPrep[]
}

model Job {
  id          String   @id @default(cuid())
  candidateId String
  title       String
  company     String
  description String?
  url         String?
  stage       String   @default("sourced") // sourced, interested, resume_tailoring, applied, recruiter_screen, hiring_manager, technical_interview, system_design, behavioral, final_round, offer, negotiation, rejected, archived
  appliedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  candidate         Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  activities        JobActivity[]
  interviewFeedback InterviewFeedback[]
  offers            Offer[]

  // Week 6: Agent Execution Timeline
  agentExecutions   AgentExecution[]

  // Week 6: Interview Preparation
  interviewPrep     InterviewPrep?

  @@index([candidateId])
  @@index([stage])
}

model JobActivity {
  id        String   @id @default(cuid())
  jobId     String
  action    String // applied, progressed, rejected, etc.
  metadata  Json?
  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model ProfileData {
  id          String   @id @default(cuid())
  candidateId String
  type        String   // resume, cover_letter, linkedin_export, notes, etc.
  content     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

model Skill {
  id          String   @id @default(cuid())
  candidateId String
  name        String
  proficiency Int      @default(1) // 1-5 scale
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, name])
  @@index([candidateId])
}

model Achievement {
  id          String   @id @default(cuid())
  candidateId String
  title       String
  description String
  metrics     Json?    // quantifiable results
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

model Document {
  id          String   @id @default(cuid())
  candidateId String
  name        String
  type        String   // pdf, docx, txt, etc.
  url         String
  uploadedAt  DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

model InterviewFeedback {
  id          String   @id @default(cuid())
  candidateId String
  jobId       String
  type        String   // behavioral, technical, system_design, other
  selfRating  Int?     // 1-5 scale
  notes       String?
  createdAt   DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([jobId])
}

model Offer {
  id          String   @id @default(cuid())
  candidateId String
  jobId       String
  salary      Int?
  equity      String?
  bonus       Int?
  startDate   DateTime?
  status      String   @default("pending") // pending, accepted, rejected, negotiating
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([jobId])
}

// ============================================================================
// WEEK 6: PROFILE INTELLIGENCE SYSTEM
// ============================================================================

// Extracted entities from documents (resumes, cover letters, etc.)
model ProfileEntity {
  id          String   @id @default(cuid())
  candidateId String
  type        String   // skill, achievement, experience, education, certification, language
  content     String   // The extracted entity text
  confidence  Float    @default(1.0) // 0-1, extraction confidence
  source      String   // resume, cover_letter, linkedin, manual, etc.
  tags        String[] // categorization tags
  relatedEntityIds String[] @default([])
  
  extractedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([type])
  @@index([source])
}

// Track extraction/parsing history and quality
model ExtractionLog {
  id          String   @id @default(cuid())
  candidateId String
  documentType String  // resume, cover_letter, linkedin
  status      String   // success, partial, failed
  totalEntities Int    // number of entities extracted
  confidence  Float    // average confidence score
  errors      String?  // error messages if failed
  duration    Int?     // milliseconds to process
  
  metadata    Json?    // document-specific metadata
  createdAt   DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([status])
}

// Profile completeness score and breakdown
model ProfileScore {
  id              String   @id @default(cuid())
  candidateId     String   @unique
  totalScore      Int      @default(0) // 0-100
  personalInfoScore Int    @default(0)
  resumeScore     Int      @default(0)
  skillsScore     Int      @default(0)
  experienceScore Int      @default(0)
  educationScore  Int      @default(0)
  goalsScore      Int      @default(0)
  portfolioScore  Int      @default(0)
  
  completeness    Float    @default(0.0) // percentage
  recommendations Json?    // array of improvement suggestions
  lastUpdated     DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

// ============================================================================
// WEEK 6: AGENT EXECUTION TIMELINE
// ============================================================================

// Track individual agent executions/tasks
model AgentExecution {
  id          String   @id @default(cuid())
  candidateId String
  jobId       String?
  agentType   String   // resume-tailor, job-match, application, research, interview-prep, etc.
  
  status      String   @default("idle") // idle, running, completed, failed, paused
  startedAt   DateTime?
  completedAt DateTime?
  duration    Int?     // milliseconds
  
  currentTask String?  // what is it currently doing
  progress    Int      @default(0) // 0-100
  
  tokenUsage  Int?     // tokens consumed
  errorMessage String?
  metadata    Json?    // task-specific data
  
  toolCalls   ToolCall[] // individual tool invocations
  eventLogs  EventLog[]    // execution events and logs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([candidateId])
  @@index([jobId])
  @@index([agentType])
  @@index([status])
}

// Individual tool calls within an agent execution
model ToolCall {
  id          String   @id @default(cuid())
  executionId String
  toolName    String   // which tool was called
  
  status      String   @default("pending") // pending, running, success, failed
  input       Json?    // tool input parameters
  output      Json?    // tool output/result
  error       String?  // error message if failed
  
  startedAt   DateTime @default(now())
  completedAt DateTime?
  duration    Int?     // milliseconds
  
  tokens      Int?     // tokens used by this call
  metadata    Json?    // additional metadata

  execution   AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@index([toolName])
  @@index([status])
}

// Agent execution events/logs
model EventLog {
  id          String   @id @default(cuid())
  executionId String
  level       String   // INFO, WARN, ERROR, DEBUG
  message     String
  data        Json?    // structured event data
  timestamp   DateTime @default(now())

  execution   AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@index([level])
  @@index([timestamp])
}

// ============================================================================
// WEEK 6: INTERVIEW PREPARATION
// ============================================================================

// Main interview prep container for a job application
model InterviewPrep {
  id          String   @id @default(cuid())
  candidateId String
  jobId       String   @unique
  
  role        String   // job title
  company     String
  
  // Content sections
  companyResearch   CompanyResearch?
  roleBreakdown     RoleBreakdown?
  starStories       StarStory[]
  technicalPrep     Json? // Technical prep data as JSON
  systemDesignPrep  Json? // System design concepts as JSON
  resumeAlignment   Json? // Resume alignment analysis as JSON
  compensationGuide Json? // Compensation discussion points as JSON
  
  // Metadata
  prepStatus   String @default("not_started") // not_started, generating, ready, stale
  confidenceScore Float @default(0.0) // 0-1
  contentVersion Int   @default(1)
  userModifications Boolean @default(false)
  
  generatedAt DateTime @default(now())
  expiresAt   DateTime? // when prep becomes stale
  lastUpdated DateTime @updatedAt
  
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([jobId])
  @@index([prepStatus])
}

// STAR story for behavioral interviews
model StarStory {
  id          String   @id @default(cuid())
  prepId      String
  
  title       String?  // Story title
  summary     String?  // Brief summary
  competency  String   // primary competency (leadership, teamwork, etc.)
  
  situation   String
  task        String
  action      String
  result      String
  
  metrics     String?  // quantifiable outcomes
  sourceProject String? // which resume project this comes from
  
  relevanceScore Float  @default(0.5) // 0-1
  confidence  Int?     // 1-5 rating
  timeToTell  Int?     // seconds to deliver
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  prep        InterviewPrep @relation(fields: [prepId], references: [id], onDelete: Cascade)

  @@index([prepId])
  @@index([competency])
}

// Company research summary
model CompanyResearch {
  id          String   @id @default(cuid())
  prepId      String   @unique
  
  company     String
  industry    String?
  size        String?  // startup, scale-up, mid-market, enterprise
  founded     Int?
  
  culture     String?  // culture summary
  recentNews  Json?    // array of news items
  technicalStack String[] @default([]) // technologies they use
  
  competitorsAndContext String?
  fundingStatus String?
  recentLayoffs String?
  
  linkedinUrl String?
  crunchbaseUrl String?
  
  salaryMin   Int?
  salaryMax   Int?
  salaryCurrency String? @default("USD")
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  prep        InterviewPrep @relation(fields: [prepId], references: [id], onDelete: Cascade)
}

// Role breakdown and requirements analysis
model RoleBreakdown {
  id          String   @id @default(cuid())
  prepId      String   @unique
  
  roleTitle   String
  seniority   String?  // junior, mid, senior, staff, principal
  reportingLine String?
  
  responsibilities Json? // array of responsibilities
  requiredSkills Json?   // array of required skills
  preferredSkills Json?  // array of preferred skills
  
  experienceRequired String?
  teamSize    Int?
  location    String?
  travelPercentage Int?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  prep        InterviewPrep @relation(fields: [prepId], references: [id], onDelete: Cascade)
}
