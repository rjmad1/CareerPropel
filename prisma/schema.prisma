// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums (RASUI-012: state-machine integrity) ───────────────────────────────

/// 14-stage job pipeline. DB-enforced — invalid stages cannot be persisted.
enum JobStage {
  sourced
  interested
  resume_tailoring
  applied
  recruiter_screen
  hiring_manager
  technical_interview
  system_design
  behavioral
  final_round
  offer
  negotiation
  rejected
  archived
}

/// Agent execution lifecycle states.
enum AgentExecutionStatus {
  queued
  running
  completed
  failed
}

/// Interview lifecycle states.
enum InterviewStatus {
  scheduled
  completed
  cancelled
  rescheduled
}

/// Job offer lifecycle states.
enum OfferStatus {
  pending
  received
  accepted
  rejected
  negotiating
}

/// Skill proficiency levels.
enum SkillProficiency {
  beginner
  intermediate
  advanced
  expert
}

// ─── Identity & Candidate Profile ───────────────────────────────────────────

model Candidate {
  id                        String    @id @default(cuid())
  email                     String    @unique
  name                      String
  phone                     String?
  location                  String?
  summary                   String?
  avatarUrl                 String?
  // Credential auth
  passwordHash              String?
  emailVerified             Boolean   @default(false)
  emailVerificationToken    String?
  emailVerificationTokenExp DateTime?
  passwordResetToken        String?
  passwordResetTokenExp     DateTime?
  // User preferences: { emailNotifications: bool, theme: 'light'|'dark'|'system' }
  preferences               Json?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  jobs              Job[]
  profileData       ProfileData[]
  skills            Skill[]
  achievements      Achievement[]
  documents         Document[]
  interviewFeedback InterviewFeedback[]
  offers            Offer[]
  interviews        Interview[]
  profileEntities   ProfileEntity[]
  profileScore      ProfileScore?
  interviewPreps    InterviewPrep[]
  starStories       StarStory[]
  calendarTokens    CalendarToken[]
  calendarEvents    CalendarEvent[]
  jobImports        JobImport[]
}

// ─── Job Pipeline ────────────────────────────────────────────────────────────

model Job {
  id             String    @id @default(cuid())
  candidateId    String
  title          String
  company        String
  description    String?
  url            String?
  location       String?
  salary         Int?
  matchScore     Float?    @default(0)
  priority       String    @default("medium") // low, medium, high
  recruiterName  String?
  recruiterEmail String?
  recruiterPhone String?
  notes          String?
  tags           String[]
  stage          JobStage  @default(sourced)
  appliedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  candidate         Candidate           @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  activities        JobActivity[]
  interviewFeedback InterviewFeedback[]
  offers            Offer[]
  interviews        Interview[]
  documents         Document[]
  interviewPrep     InterviewPrep?

  @@index([candidateId])
  @@index([stage])
}

model JobActivity {
  id        String   @id @default(cuid())
  jobId     String
  action    String // applied, progressed, rejected, etc.
  metadata  Json?
  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model Interview {
  id              String          @id @default(cuid())
  candidateId     String
  jobId           String
  type            String // phone, video, onsite, panel, technical, behavioral
  scheduledAt     DateTime
  duration        Int? // minutes
  location        String?
  meetingLink     String?
  calendarEventId String? // linked CalendarEvent.id after auto-sync
  notes           String?
  status          InterviewStatus @default(scheduled)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([jobId])
}

model InterviewFeedback {
  id          String   @id @default(cuid())
  candidateId String
  jobId       String
  type        String // behavioral, technical, system_design, other
  selfRating  Int? // 1-5 scale
  notes       String?
  createdAt   DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([jobId])
}

model Offer {
  id          String      @id @default(cuid())
  candidateId String
  jobId       String
  salary      Int?
  equity      String?
  bonus       Int?
  benefits    String?
  startDate   DateTime?
  status      OfferStatus @default(pending)
  negotiated  Boolean     @default(false)
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([jobId])
}

// ─── Profile Intelligence ────────────────────────────────────────────────────

model ProfileData {
  id          String   @id @default(cuid())
  candidateId String
  type        String // resume, cover_letter, linkedin_export, notes, etc.
  content     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, type])
  @@index([candidateId])
}

model Skill {
  id          String           @id @default(cuid())
  candidateId String
  name        String
  proficiency SkillProficiency @default(beginner)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, name])
  @@index([candidateId])
}

model Achievement {
  id          String   @id @default(cuid())
  candidateId String
  title       String
  description String
  metrics     Json? // quantifiable results
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

model Document {
  id          String   @id @default(cuid())
  candidateId String
  jobId       String?
  name        String
  type        String // resume, cover_letter, pdf, docx, txt, etc.
  url         String?
  content     String?
  version     String?
  tags        String[]
  uploadedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([candidateId])
  @@index([jobId])
}

model ProfileEntity {
  id          String   @id @default(cuid())
  candidateId String
  type        String // skill, experience, education, certification, project, etc.
  data        Json
  source      String? // which document or profile data it was extracted from
  confidence  Float? // AI extraction confidence score (0-1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([type])
}

model ProfileScore {
  id              String   @id @default(cuid())
  candidateId     String   @unique
  overall         Int      @default(0) // 0-100
  sections        Json? // per-section breakdown
  recommendations Json? // improvement suggestions
  calculatedAt    DateTime @default(now())
  updatedAt       DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

// ─── Interview Intelligence ──────────────────────────────────────────────────

model InterviewPrep {
  id                String    @id @default(cuid())
  candidateId       String
  jobId             String    @unique // one prep package per job
  role              String
  company           String
  prepStatus        String    @default("not_started") // not_started, generating, ready, stale
  confidenceScore   Float     @default(0) // 0–1
  contentVersion    Int       @default(1)
  companyResearch   Json? // serialised CompanyResearch
  roleBreakdown     Json? // serialised RoleBreakdown
  technicalPrep     Json? // serialised TechnicalPrep
  systemDesignPrep  Json? // serialised SystemDesignPrep
  resumeAlignment   Json? // serialised ResumeAlignment
  compensationGuide Json? // serialised CompensationGuide
  generatedAt       DateTime?
  expiresAt         DateTime?
  userModifications Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  candidate   Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job         Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  starStories StarStory[]

  @@index([candidateId])
}

model StarStory {
  id                 String   @id @default(cuid())
  candidateId        String
  interviewPrepId    String? // optional: linked to a specific prep package
  competency         String // primary competency (e.g. "leadership")
  competencies       String[] // additional competencies this story covers
  title              String
  summary            String?
  situation          String
  task               String
  action             String
  result             String
  metrics            String[] // quantifiable outcomes
  sourceProject      String? // project from resume this story draws from
  relevanceScore     Float    @default(0) // 0–1
  timeToTell         Int? // estimated seconds to deliver
  confidence         Int? // 0–100 user confidence rating
  interviewQuestions String[] // interview questions this story can answer
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  candidate     Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  interviewPrep InterviewPrep? @relation(fields: [interviewPrepId], references: [id], onDelete: SetNull)

  @@index([candidateId])
  @@index([interviewPrepId])
}

// ─── Agent Operations ────────────────────────────────────────────────────────

model AgentExecution {
  id           String               @id @default(cuid())
  userId       String // NextAuth user ID or email — not a FK
  agentType    String // resume-tailor, job-match, interview-prep, research, follow-up, networking
  status       AgentExecutionStatus @default(queued)
  input        String? // JSON-serialised AgentPromptContext
  output       String? // JSON-serialised result
  tokenCount   Int?
  durationMs   Int?
  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  toolCalls ToolCall[]
  eventLogs EventLog[]

  @@index([userId])
  @@index([status])
}

model ToolCall {
  id          String    @id @default(cuid())
  executionId String
  tool        String // tool name/identifier
  input       Json?
  output      Json?
  error       String?
  status      String    @default("pending") // pending, running, completed, failed
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  execution AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
}

model EventLog {
  id          String   @id @default(cuid())
  executionId String
  level       String // INFO, WARN, ERROR
  message     String
  metadata    Json?
  timestamp   DateTime @default(now())

  execution AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@index([timestamp])
}

// ─── Security & Admin ────────────────────────────────────────────────────────

model Role {
  id          String   @id @default(cuid())
  name        String   @unique // "admin", "recruiter", "candidate", etc.
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  userRoles   UserRole[]
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique // "jobs.create", "jobs.read", "jobs.update", "jobs.delete", etc.
  description String?
  resource    String // "jobs", "users", "audit", etc.
  action      String // "create", "read", "update", "delete", "manage"
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@unique([resource, action])
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRole {
  id        String    @id @default(cuid())
  email     String // Links to Candidate email
  roleId    String
  grantedBy String? // Email of admin who granted
  grantedAt DateTime  @default(now())
  expiresAt DateTime? // Optional role expiration
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([email, roleId])
  @@index([email])
  @@index([roleId])
}

model TwoFactorSecret {
  id          String    @id @default(cuid())
  email       String    @unique
  secret      String // Encrypted TOTP secret
  backupCodes String[] // Encrypted backup codes
  enabled     Boolean   @default(false)
  enabledAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([email])
}

model ApiKey {
  id         String    @id @default(cuid())
  email      String // Links to Candidate email
  keyHash    String // Hash of the actual key (key itself never stored)
  name       String // User-defined name
  prefix     String    @unique // "sk_" prefix for identification
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
  lastUsedAt DateTime?
  revokedAt  DateTime?
  usageCount Int       @default(0)

  @@unique([email, name])
  @@index([email])
  @@index([prefix])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  email      String
  action     String // LOGIN, JOB_CREATED, JOB_DELETED, API_KEY_CREATED, etc.
  resource   String
  resourceId String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  status     String // "success" or "failure"
  severity   String   @default("info") // "info", "warning", "error", "critical"
  createdAt  DateTime @default(now())

  @@index([email])
  @@index([action])
  @@index([createdAt])
  @@index([severity])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  ipAddress String?
  userAgent String?
  timestamp DateTime @default(now())

  @@index([email])
  @@index([timestamp])
  @@index([success])
}

model SessionActivity {
  id        String   @id @default(cuid())
  email     String
  sessionId String
  action    String // "login", "logout", "api_call", "data_access", etc.
  ipAddress String?
  userAgent String?
  riskScore Int      @default(0) // 0-100, higher = more suspicious
  timestamp DateTime @default(now())

  @@index([email])
  @@index([sessionId])
  @@index([timestamp])
  @@index([riskScore])
}

// ─── Calendar Integration ─────────────────────────────────────────────────────

model CalendarToken {
  id           String    @id @default(cuid())
  candidateId  String
  provider     String // "google" | "outlook"
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  scope        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, provider])
  @@index([candidateId])
}

model CalendarEvent {
  id          String   @id @default(cuid())
  candidateId String
  externalId  String // Google/Outlook event ID
  provider    String // "google" | "outlook"
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime
  location    String?
  meetingUrl  String?
  jobId       String?
  interviewId String?
  syncedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, externalId, provider])
  @@index([candidateId])
  @@index([startAt])
}

// ─── Job Board Import ─────────────────────────────────────────────────────────

model JobImport {
  id          String   @id @default(cuid())
  candidateId String
  source      String // "greenhouse" | "indeed" | "linkedin" | "manual"
  externalId  String? // source job ID where available
  rawData     Json // full scraped/fetched payload
  imported    Boolean  @default(false)
  jobId       String? // set after user accepts and a Job record is created
  createdAt   DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([source])
}

// ─── AI Platform Evolution Configurations ────────────────────────────────────

model AiProviderConfig {
  id           String    @id @default(cuid())
  candidateId  String
  providerName String    // "openai", "anthropic", "gemini", "ollama", "openrouter", etc.
  endpointUrl  String?   // Custom endpoint (e.g. http://localhost:11434/api)
  encryptedKey String?   // AES-GCM encrypted API key
  isActive     Boolean   @default(true)
  priority     Int       @default(1)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([candidateId, providerName])
  @@index([candidateId])
}

model UserCapabilityPreset {
  id           String    @id @default(cuid())
  candidateId  String
  presetName   String    // "resume_optimization", "technical_interview", etc.
  providerName String    // Selected fallback provider
  modelName    String    // Selected fallback model
  maxCostLimit Float     @default(0.05) // Max spend per invocation
  privacyMode  String    @default("enterprise") // "local", "zero_retention", "enterprise", "anonymous"
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([candidateId, presetName])
  @@index([candidateId])
}

model TokenUsageLog {
  id           String    @id @default(cuid())
  candidateId  String
  executionId  String?
  presetName   String
  providerName String
  modelName    String
  inputTokens  Int
  outputTokens Int
  costUsd      Float
  createdAt    DateTime  @default(now())

  @@index([candidateId])
  @@index([createdAt])
}

model PromptVersion {
  id          String   @id @default(cuid())
  capability  String   // E.g., "ATS_OPTIMIZATION"
  version     Int      @default(1)
  template    String   // Prompt template text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([capability, version])
  @@index([capability])
}

model ModelHealthLog {
  id           String   @id @default(cuid())
  providerName String
  modelName    String
  latencyMs    Int
  isSuccess    Boolean
  statusCode   Int?
  errorMessage String?
  timestamp    DateTime @default(now())

  @@index([providerName, modelName])
  @@index([timestamp])
}

