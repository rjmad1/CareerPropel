  ARCHETYPE_CORRELATION
  SUCCESS_METRIC
}

// ─── Role Intelligence Models ────────────────────────────────────────────────

/// Job Intelligence — deconstructed operational metadata for a job posting
model JobIntelligence {
  id          String @id @default(cuid())
  jobId       String @unique
  candidateId String

  // Step 1: Inferred role (no title bias)
  inferredRole     String // e.g. "roadmap operator", "delivery manager"
  roleArchetype    RoleArchetype // primary archetype
  archetypeWeights Json // { BUILDER: 0.3, OPERATOR: 0.6, ... }
  roleClarityScore Float // 0-1 how clearly the real role is defined

  // Step 2-3: Requirement breakdown (JSON for flexibility)
  hardRequirements Json // [{ requirement, tools, decisions, outputs, metrics, ownership, complexity }]
  softRequirements Json // [{ requirement, confidenceScore, reason }]

  // Step 4: Operational signals extracted from responsibility patterns
  operationalDomain           String // primary domain
  recurringResponsibilities   Json // [{ responsibility, frequency, weight, companies }]
  decisionOwnership           String[] // decisions this role owns
  operationalScope            String // scope description
  executionComplexity         Int // 1-10
  systemsResponsibility       String? // systems this role manages
  crossFunctionalCoordination String? // coordination scope
  reportingStructure          Json? // reports to, manages
  organizationalLeverage      Int // 1-10

  // Metadata
  analysisVersion Int      @default(1)
  analyzedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  job                   Job                    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate             Candidate              @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  requirementBreakdowns RequirementBreakdown[]
  businessProblems      BusinessProblem[]
  operationalSignals    OperationalSignal[]

  @@index([candidateId])
  @@index([jobId])
  @@index([roleArchetype])
  @@index([inferredRole])
}

/// Detailed requirement deconstruction — one per hard requirement
model RequirementBreakdown {
  id                String @id @default(cuid())
  jobIntelligenceId String
  requirement       String // original requirement text
  classification    String // "hard" | "soft" | "wishlist"
  confidenceScore   Float // 0-1 confidence in classification

  // Deconstruction
  tools                 String[] // tools/platforms mentioned
  decisions             String[] // decisions this requirement implies
  outputs               String[] // expected deliverables/outputs
  metrics               String[] // success metrics implied
  ownership             String // ownership level implied
  operationalComplexity Int // 1-10
  collaborationSurface  String[] // stakeholders/cross-functional touchpoints
  businessImpact        String? // business outcome this requirement ties to
  executionCadence      String? // daily, weekly, quarterly, etc
  riskLevel             Int // 1-10 hiring risk if missing

  createdAt DateTime @default(now())

  jobIntelligence JobIntelligence @relation(fields: [jobIntelligenceId], references: [id], onDelete: Cascade)

  @@index([jobIntelligenceId])
  @@index([classification])
}

/// Business problems inferred from the job posting — employer pain points
model BusinessProblem {
  id                  String  @id @default(cuid())
  jobIntelligenceId   String
  problem             String // employer pain point description
  category            String // scaling, execution, technical_debt, process, etc
  severity            Int // 1-10
  urgencySignal       String? // hiring urgency signals found
  operationalFriction String? // specific operational friction
  scalingChallenge    String? // scaling bottleneck
  executionBottleneck String? // execution bottleneck
  evidence            String? // text evidence from JD

  createdAt DateTime @default(now())

  jobIntelligence JobIntelligence @relation(fields: [jobIntelligenceId], references: [id], onDelete: Cascade)

  @@index([jobIntelligenceId])
  @@index([category])
}

/// Operational signals — recurring responsibility patterns
model OperationalSignal {
  id                String   @id @default(cuid())
  jobIntelligenceId String
  signal            String // signal description
  signalType        String // recurring_responsibility, business_outcome, system_ownership, etc
  frequency         Float // 0-1 frequency across related roles
  weight            Float // importance weight for scoring
  sourceCompanies   String[] // companies where this signal was found

  createdAt DateTime @default(now())

  jobIntelligence JobIntelligence @relation(fields: [jobIntelligenceId], references: [id], onDelete: Cascade)

  @@index([jobIntelligenceId])
  @@index([signalType])
}

/// Strength evidence — mapped candidate proof against employer needs
model StrengthEvidence {
  id          String  @id @default(cuid())
  candidateId String
  jobId       String?
  source      String // resume, accomplishment, star_story, etc
  capability  String // the capability demonstrated

  // Evidence mapping
  measurableOutcome     String? // quantified result
  businessImpact        String? // business outcome
  executionContext      String? // context of execution
  scale                 String? // scale of impact
  decisionOwnership     String? // decisions owned
  operationalComplexity Int? // complexity level 1-10
  systemsInfluenced     String[] // systems touched
  stakeholderLevel      String? // stakeholder seniority
  repeatability         String? // how repeatable is this

  // Translation to employer language
  employerInterpretation String? // normalized business language
  economicImpact         String? // economic impact statement
  operationalLeverage    String? // operational leverage

  // Prioritization
  rarityScore             Float @default(0) // 0-1 how rare/valuable
  leverageScore           Float @default(0) // 0-1 how high-leverage
  replacementCost         Float @default(0) // 0-1 how expensive to replace
  businessBottleneckScore Float @default(0) // 0-1 how tied to business bottlenecks

  // Problem matching
  matchedProblems String[] // links to BusinessProblem descriptions
  matchConfidence Float    @default(0) // 0-1

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([candidateId])
  @@index([jobId])
  @@index([capability])
  @@index([rarityScore])
}

/// Fit gap analysis — classified gaps between candidate and role
model FitGap {
  id                String            @id @default(cuid())
  candidateId       String
  jobId             String
  gap               String // gap description
  classification    GapClassification // TRAINABLE, CREDIBILITY_KILLING, DOMAIN_DEPTH, ADAPTATION_SPEED
  severity          Int // 1-10
  penaltyMultiplier Float             @default(1.0) // multiplicative penalty on fit score

  // For trainable gaps
  adjacentProof     String? // adjacent evidence that mitigates
  learningTime      String? // estimated learning time
  learningResources String[] // resources to close gap

  // For credibility-killing gaps
  blockingReason   String? // why this gap blocks trust
  alternativeRoute String? // alternative path if one exists

  // For domain depth gaps
  domainRequired String? // domain name
  adjacentDomain String? // adjacent domain with proof

  // Adaptation analysis
  onboardingComplexity Int? // 1-10
  learningCurve        String? // steep, moderate, shallow
  operationalRampTime  String? // estimated ramp time

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([jobId])
  @@index([classification])
}

/// Fit scoring snapshot — comprehensive per-role fit analysis
model FitScoringSnapshot {
  id          String @id @default(cuid())
  candidateId String
  jobId       String @unique

  // Core scores
  fitScore                       Float // 0-1 overall fit
  interviewConversionProbability Float // 0-1 probability
  immediateContributionScore     Float // 0-1
  credibilityRiskScore           Float // 0-1 (inverted: higher = more risk)
  skillTransferScore             Float // 0-1
  businessProblemAlignmentScore  Float // 0-1
  adaptationRiskScore            Float // 0-1 (higher = more risk)
  roleClarityScore               Float // 0-1
  employerPainMatchScore         Float // 0-1

  // 11-dimension weighted breakdown
  dimensionScores Json // { [FitDimension]: { score, weight, contribution, evidence } }

  // Weights used (versions for recalibration)
  weightsVersion Int  @default(1)
  weights        Json // { [FitDimension]: weight }

  // Probability determinants
  strongestLeveragePoints     String[] // top 3 leverage factors
  biggestBlockers             String[] // top 3 blocking factors
  expectedRecruiterPerception String? // how recruiter will perceive this match

  // Recommendation
  recommendation          String // STRONG_PURSUE, PURSUE, CONSIDER, DEPRIORITIZE, SUPPRESS
  recommendationRationale String?

  // Suppression rules
  suppressed        Boolean @default(false)
  suppressionReason String?

  // Run metadata
  analysisVersion Int      @default(1)
  analyzedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([jobId])
  @@index([fitScore])
  @@index([interviewConversionProbability])
  @@index([suppressed])
}

/// Role intelligence analysis — non-unique version of FitScoringSnapshot for history
model RoleFitAnalysis {
  id          String @id @default(cuid())
  candidateId String
  jobId       String

  // Analysis type
  analysisType String // "role_intelligence" | "fit_analysis" | "strength_mapping" | "gap_analysis" | "conversion_scoring"

  // Snapshot of results (JSON-backed for flexibility)
  results Json

  // Processing metadata
  executionId  String? // link to AgentExecution
  agentType    String? // which agent produced this
  modelVersion String? // model version used
  tokenUsage   Int?

  createdAt DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([jobId])
  @@index([analysisType])
  @@index([createdAt])
}

/// Pattern library entry — reusable intelligence from successful matches
model PatternLibraryEntry {
  id          String          @id @default(cuid())
  candidateId String
  category    PatternCategory
  pattern     String // the pattern/insight
  description String? // human-readable description

  // Correlation data
  confidenceScore      Float          @default(0) // 0-1
  frequencyObserved    Int            @default(1)
  conversionRate       Float? // 0-1 interview conversion rate
  archetypeCorrelation RoleArchetype? // archetype this pattern maps to

  // Evidence
  sourceJobIds String[] // job IDs where this was observed
  evidenceText String? // textual evidence
  metrics      Json? // performance metrics

  // Weight impact
  weightModifier Float   @default(0) // +/- adjustment to scoring weights
  active         Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([category])
  @@index([conversionRate])
  @@index([active])
}
