  RESPONSIBILITY_OVERLAP
  TOOL_OVERLAP
  KEYWORD_OVERLAP
  ADJACENT_SKILL_TRANSFER
  DOMAIN_FAMILIARITY
  ARCHETYPE_ALIGNMENT
  IMMEDIATE_CONTRIBUTION_CAPABILITY
  STRATEGIC_IMPACT_ALIGNMENT
