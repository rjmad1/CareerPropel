# =============================================================================
# Phase 2: Claude API Integration & Agent Orchestration
# =============================================================================

# LLM Provider Configuration
# Options: 'anthropic' (default) or 'nvidia-nim'
LLM_PROVIDER=anthropic

# Anthropic API Configuration
ANTHROPIC_API_KEY=sk-ant-your-actual-api-key-here

# Nvidia NIM Configuration (optional, for economical/free inference)
# Uncomment and configure when switching to NIM
# NIM_API_KEY=your-nvidia-api-key
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NIM_MODEL=meta/llama2-70b-chat

# Agent Execution Security
# Secret key to prevent unauthorized background polling (recommended for production)
# EXECUTOR_SECRET=your-secret-key-here

# WebSocket Configuration
# Used for real-time agent status updates
NEXT_PUBLIC_WS_URL=http://localhost:3000
WS_HEARTBEAT_INTERVAL=30000

# Redis Configuration (for pub/sub event system)
REDIS_URL=redis://localhost:6379
REDIS_CHANNELS_PREFIX=career-propel:

# Agent Execution Limits
# Maximum concurrent agents per user
MAX_CONCURRENT_AGENTS_PER_USER=5
# Maximum tokens per execution
MAX_TOKENS_PER_EXECUTION=4096
# Execution timeout in milliseconds
AGENT_EXECUTION_TIMEOUT_MS=300000

# Polling Configuration
# Interval between background executor runs (milliseconds)
EXECUTOR_POLLING_INTERVAL_MS=5000
# Number of pending executions to process per poll
EXECUTOR_BATCH_SIZE=5

# Token Budget Management
# Daily token limit per user (0 = unlimited)
DAILY_TOKEN_BUDGET=100000
# Cost tracking granularity (for future billing)
TRACK_TOKEN_COSTS=true

# Feature Flags
ENABLE_STREAMING=true
ENABLE_REAL_TIME_UPDATES=true
ENABLE_AGENT_COMPOSITION=false
ENABLE_EXECUTION_COST_LIMITS=false

# Logging Configuration
LOG_LEVEL=debug
LOG_AGENT_TOKENS=true
LOG_EXECUTION_DURATION=true
