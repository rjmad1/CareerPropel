{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/next",
      "args": ["dev"],
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "ready - started server on",
        "uriFormat": "http://localhost:3000"
      }
    }
  ]
}
