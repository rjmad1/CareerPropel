{
    "name": "career-ops",
    "version": "1.0.0",
    "description": "AI-native career management platform with autonomous job application automation",
    "scripts": {
        "dev": "cross-env NODE_ENV=development node server.js",
        "dev:next": "cross-env NODE_ENV=development next dev",
        "build": "next build",
        "start": "node server.js",
        "lint": "eslint src --ext .ts,.tsx",
        "type-check": "tsc --noEmit",
        "format": "prettier --write .",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:e2e": "cypress run",
        "test:e2e:open": "cypress open",
        "db:push": "prisma db push",
        "db:migrate": "prisma migrate dev",
        "db:seed": "prisma db seed",
        "db:studio": "prisma studio",
        "docs": "typedoc",
        "docs:watch": "typedoc --watch",
        "docs:clean": "rimraf docs/api",
        "dep:graph": "depcruise src --config .dependency-cruiser/.dependency-cruiser.js --output-type mermaid --output-to docs/architecture/dependency-graph.mmd",
        "dep:html": "depcruise src --config .dependency-cruiser/.dependency-cruiser.js --output-type html --output-to docs/architecture/dependency-report.html",
        "madge:circular": "madge --circular src",
        "madge:image": "madge --image docs/diagrams/module-graph.svg src",
        "docs:full": "npm run docs && npm run dep:graph && npm run dep:html && npm run madge:image"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.96.0",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/icons-material": "^9.0.1",
        "@mui/lab": "^9.0.0-beta.3",
        "@mui/material": "^9.0.1",
        "@prisma/client": "^5.0.0",
        "@tanstack/react-query": "^5.0.0",
        "axios": "^1.5.0",
        "ioredis": "^5.10.1",
        "lucide-react": "^1.16.0",
        "next": "^14.0.0",
        "next-auth": "^4.24.14",
        "pino": "^8.16.0",
        "prisma": "^5.0.0",
        "qrcode": "^1.5.4",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "redis": "^4.6.0",
        "socket.io": "^4.7.0",
        "socket.io-client": "^4.7.0",
        "playwright": "^1.40.0",
        "speakeasy": "^2.0.0",
        "tailwindcss": "^3.3.0",
        "typescript": "^5.2.0",
        "zod": "^3.22.0",
        "zustand": "^4.4.0"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    },
    "devDependencies": {
        "@mermaid-js/mermaid-cli": "^11.15.0",
        "@prisma/internals": "^5.0.0",
        "@testing-library/jest-dom": "^6.1.0",
        "@testing-library/react": "^14.0.0",
        "@types/node": "^20.5.0",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "@types/speakeasy": "^2.0.10",
        "@types/uuid": "^10.0.0",
        "@typescript-eslint/eslint-plugin": "^6.0.0",
        "@typescript-eslint/parser": "^6.0.0",
        "cross-env": "^10.1.0",
        "cypress": "^13.6.0",
        "dependency-cruiser": "^17.4.0",
        "eslint": "^8.48.0",
        "eslint-config-next": "^14.0.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^30.4.1",
        "madge": "^8.0.0",
        "prettier": "^3.0.0",
        "rimraf": "^6.1.3",
        "tsx": "^4.22.1",
        "typedoc": "^0.28.19",
        "typedoc-plugin-markdown": "^4.11.0",
        "typedoc-plugin-merge-modules": "^7.0.0",
        "typedoc-plugin-missing-exports": "^4.1.3"
    }
}
