{
  "name": "career-ops",
  "version": "1.0.0",
  "description": "AI-native career management platform with autonomous job application automation",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "tsx src/bin/web.ts",
    "start:web": "tsx src/bin/web.ts",
    "start:worker": "tsx src/bin/worker.ts",
    "start:scheduler": "tsx src/bin/scheduler.ts",
    "lint": "eslint src",
    "governance-check": "tsx scripts/governance-check.ts",
    "governance:ast": "ast-grep scan",
    "governance:full": "npm run governance-check && npm run governance:ast && npm run depcruise && npm run madge:ci && npx tsx scripts/architecture/validate-runtime-boundaries.ts && npx tsx scripts/architecture/validate-deprecated-imports.ts && npx tsx scripts/architecture/validate-realtime-model.ts && npx tsx scripts/architecture/validate-governance-integrity.ts",
    "type-check": "tsc --noEmit",
    "test:reliability": "jest src/__tests__/reliability",
    "test:invariants": "jest src/__tests__/invariants",
    "test:chaos": "jest tests/runtime-hardening.test.ts",
    "test:load": "tsx src/lib/testing/load/load-simulation.ts",
    "ci-governance": "npm run type-check && npm run lint && npm run governance:full",
    "format": "prettier --write .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test tests/smoke",
    "docs": "typedoc",
    "knip": "knip",
    "madge:circular": "madge --circular src",
    "madge:ci": "madge --circular --extensions ts,tsx src",
    "depcruise": "depcruise src --config .dependency-cruiser/.dependency-cruiser.js",
    "madge:orphans": "madge --orphans src",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "wiki:sync": "node scripts/sync-wiki.js",
    "wiki:install-hooks": "node scripts/install-hooks.js",
    "postinstall": "node scripts/install-hooks.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@bull-board/api": "^7.1.5",
    "@bull-board/express": "^7.1.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.1",
    "@mui/lab": "^9.0.0-beta.3",
    "@mui/material": "^9.0.1",
    "@prisma/client": "^5.0.0",
    "@sentry/nextjs": "^10.54.0",
    "@tanstack/react-query": "^5.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/dompurify": "^3.0.5",
    "axios": "^1.5.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.63.0",
    "dompurify": "^3.4.6",
    "ioredis": "^5.10.1",
    "lucide-react": "^1.16.0",
    "mammoth": "^1.12.0",
    "next": "^16.0.0",
    "next-auth": "^4.24.14",
    "pdf-parse": "^2.4.5",
    "pino": "^8.16.0",
    "prisma": "^5.0.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "resend": "^6.12.4",
    "server-only": "^0.0.1",
    "speakeasy": "^2.0.0",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.20.6",
    "zod": "^3.22.0",
    "zustand": "^4.4.0"
  },
  "overrides": {
    "postcss": ">=8.5.10",
    "uuid": ">=11.1.1"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.43.0",
    "@playwright/test": "^1.60.0",
    "@prisma/internals": "^5.0.0",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^14.0.0",
    "@types/node": "^20.5.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "autoprefixer": "^10.5.0",
    "dependency-cruiser": "^17.4.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "knip": "^6.14.2",
    "madge": "^8.0.0",
    "playwright": "^1.40.0",
    "prettier": "^3.0.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typedoc-plugin-merge-modules": "^7.0.0",
    "typescript": "^6.0.3"
  }
}
