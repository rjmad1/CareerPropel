{
    "name": "career-propel",
    "version": "1.0.0",
    "description": "AI-native career management platform with autonomous job application automation",
    "scripts": {
        "dev": "cross-env NODE_ENV=development node server.js",
        "dev:next": "cross-env NODE_ENV=development next dev",
        "build": "prisma migrate deploy && prisma generate && next build",
        "start": "node server.js",
        "lint": "eslint src",
        "type-check": "tsc --noEmit",
        "spec:check": "node scripts/governance/spec-check.js",
        "security:audit": "npm audit --audit-level=moderate",
        "security:deps": "npm ls next ws postcss uuid --all",
        "security:secrets": "bash scripts/security/scan-secrets.sh",
        "security:scan": "npm run security:audit && npm run security:deps && npm run security:secrets",
        "validate": "npm run lint && npm run type-check && npm test && npm run security:scan",
        "prepare": "husky",
        "format": "prettier --write .",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:integration": "jest --testPathPattern='src/__tests__/integration'",
        "test:e2e": "cypress run",
        "test:e2e:open": "cypress open",
        "db:push": "prisma db push",
        "db:migrate": "prisma migrate dev",
        "db:seed": "prisma db seed",
        "db:studio": "prisma studio",
        "docs": "typedoc",
        "docs:watch": "typedoc --watch",
        "docs:clean": "rimraf docs/api",
        "dep:graph": "depcruise src --config .dependency-cruiser/.dependency-cruiser.js --output-type mermaid --output-to docs/architecture/dependency-graph.mmd",
        "dep:html": "depcruise src --config .dependency-cruiser/.dependency-cruiser.js --output-type html --output-to docs/architecture/dependency-report.html",
        "madge:circular": "madge --circular src",
        "madge:image": "madge --image docs/diagrams/module-graph.svg src",
        "docs:full": "npm run docs && npm run dep:graph && npm run dep:html && npm run madge:image",
        "demo:seed": "tsx scripts/seed-demo-data.ts",
        "demo:seed:small": "tsx scripts/seed-demo-data.ts --profile=small",
        "demo:seed:medium": "tsx scripts/seed-demo-data.ts --profile=medium",
        "demo:seed:enterprise": "tsx scripts/seed-demo-data.ts --profile=enterprise",
        "demo:seed:stress": "tsx scripts/seed-demo-data.ts --profile=stress-test",
        "demo:purge": "tsx scripts/purge-demo-data.ts",
        "demo:purge:dry": "tsx scripts/purge-demo-data.ts --dry-run",
        "demo:verify": "tsx scripts/seed-demo-data.ts --profile=medium --dry-run --verify",
        "worker": "tsx src/bin/worker.ts",
        "worker:prod": "node dist/bin/worker.js",
        "migrate:calendar-tokens": "tsx scripts/migrate-calendar-tokens.ts"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.96.0",
        "@prisma/client": "^5.0.0",
        "@tanstack/react-query": "^5.0.0",
        "axios": "^1.5.0",
        "bcryptjs": "^3.0.3",
        "bullmq": "^5.77.1",
        "dompurify": "^3.3.1",
        "ioredis": "^5.10.1",
        "lucide-react": "^1.16.0",
        "next": "^16.2.6",
        "next-auth": "^4.24.14",
        "pino": "^8.16.0",
        "playwright": "^1.40.0",
        "prisma": "^5.0.0",
        "qrcode": "^1.5.4",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "redis": "^5.0.0",
        "resend": "^6.12.3",
        "socket.io": "^4.8.3",
        "socket.io-client": "^4.8.3",
        "speakeasy": "^2.0.0",
        "tailwindcss": "^3.3.0",
        "typescript": "^5.2.0",
        "zod": "^3.22.0",
        "zustand": "^4.4.0"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.3",
        "@mermaid-js/mermaid-cli": "^11.15.0",
        "@prisma/internals": "^5.0.0",
        "@testing-library/jest-dom": "^6.1.0",
        "@testing-library/react": "^14.0.0",
        "@types/bcryptjs": "^2.4.6",
        "@types/jest": "^30.0.0",
        "@types/node": "^20.5.0",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "@types/speakeasy": "^2.0.10",
        "@types/uuid": "^10.0.0",
        "@typescript-eslint/eslint-plugin": "^8.59.4",
        "@typescript-eslint/parser": "^8.59.4",
        "autoprefixer": "^10.5.0",
        "cross-env": "^10.1.0",
        "cypress": "^13.6.0",
        "dependency-cruiser": "^17.4.0",
        "eslint": "^9.39.2",
        "eslint-config-next": "^16.2.6",
        "husky": "^9.1.7",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^30.4.1",
        "madge": "^8.0.0",
        "prettier": "^3.0.0",
        "rimraf": "^6.1.3",
        "tsx": "^4.22.1",
        "typedoc": "^0.28.19",
        "typedoc-plugin-markdown": "^4.11.0",
        "typedoc-plugin-merge-modules": "^7.0.0",
        "typedoc-plugin-missing-exports": "^4.1.3"
    },
    "overrides": {
        "postcss": "^8.5.14",
        "ws": "^8.20.1"
    }
}
