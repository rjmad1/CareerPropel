{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(npm *)",
      "Bash(node *)",
      "Bash(pnpm *)",
      "Bash(npx *)",
      "Bash(vercel *)",
      "Bash(powershell.exe *)",
      "PowerShell(git *)",
      "PowerShell(npm *)",
      "PowerShell(node *)",
      "PowerShell(pnpm *)",
      "PowerShell(vercel *)",
      "Bash(npm run lint)",
      "Bash(npm run lint:file *)",
      "Bash(npm run typecheck)",
      "Bash(npm run test)",
      "Bash(npm run test:run)",
      "Bash(npx vitest run *)",
      "Read(./**)",
      "Write(./**)",
      "Edit(./**)",
      "MultiEdit(./**)",
      "Glob(./**)",
      "Grep(./**)",
      "LS(./**)",
      "NotebookEdit(./**)",
      "Bash(Get-ChildItem -Path \"c:\\\\Users\\\\rajaj\\\\career-ops\" -Recurse -Depth 2 -Directory)",
      "Bash(dir \"c:\\\\Users\\\\rajaj\\\\career-ops\\\\src\\\\app\\\\\\(auth\\)\")",
      "Bash(python -c \"import sys,json; d=json.load\\(sys.stdin\\); print\\(json.dumps\\({k:v for k,v in {**d.get\\('dependencies',{}\\),**d.get\\('devDependencies',{}\\)}.items\\(\\) if any\\(x in k for x in ['zod','bcrypt','resend','next-auth','prisma']\\)}, indent=2\\)\\)\")",
      "Read(//c/Users/rajaj/.claude/projects/c--Users-rajaj-career-ops/memory/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ],
    "additionalDirectories": [
      "c:\\Users\\rajaj\\.claude\\projects\\c--Users-rajaj-career-ops\\memory"
    ]
  },
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "code-builder|code-validator|validation-orchestrator",
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p .claude/logs && printf '%s | START | %s\\n' \"$(date -Iseconds)\" \"$CLAUDE_AGENT_TYPE\" >> .claude/logs/subagents.log"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "code-builder|code-validator|validation-orchestrator",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/log-subagent-stop.sh"
          }
        ]
      }
    ]
  }
}
